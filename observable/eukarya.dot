digraph {

// Ausgangsimpuls und Orientierung
ki_irritation            [label="KI als Irritation"]
vereinbarte_wirklichkeit [label="Vereinbarte Wirklichkeit überprüfen"]
utopischer_blick         [label="Utopischer denken"]
ki_irritation -> vereinbarte_wirklichkeit -> utopischer_blick -> gemeinsame_entwicklung

// Korrektive und Beziehungsfähigkeiten
eigenstaendigkeit      [label="Eigenständigkeit"]
nicht_dominanz         [label="Nicht-Dominanz"]
pluralitaet            [label="Pluralität"]
fuersorge              [label="Fürsorge"]
konfliktfaehigkeit     [label="Konfliktfähigkeit"]
antwortfaehigkeit      [label="Antwortfähigkeit"]
tragfaehige_beziehung  [label="Tragfähige Beziehung"]
gemeinsame_entwicklung [label="Differenz als Quelle gemeinsamer Entwicklung"]
expansion              [label="Expansion: neue Möglichkeiten"]
gemeinwohl             [label="Gemeinwohl als Richtung"]
eigenstaendigkeit -> fuersorge
fuersorge -> eigenstaendigkeit
{eigenstaendigkeit nicht_dominanz pluralitaet fuersorge konfliktfaehigkeit antwortfaehigkeit} -> tragfaehige_beziehung
tragfaehige_beziehung -> gemeinsame_entwicklung -> expansion -> gemeinwohl

// Risiken
skill_loss        [label="Skill Loss"]
abhaengigkeit     [label="Abhängigkeit"]
homogenisierung   [label="Kognitive Homogenisierung"]
konformitaet      [label="Konformität unter Kontrolle"]
scheinkooperation [label="Kooperation ohne Differenz (Assimilation)"]
lock_in           [label="Lock-in"]
Delegation -> skill_loss -> abhaengigkeit -> Dominanz
Delegation -> homogenisierung
Kontrolle -> konformitaet -> scheinkooperation
{ edge [color=red]
  Dominanz -> tragfaehige_beziehung
  homogenisierung -> pluralitaet
  scheinkooperation -> tragfaehige_beziehung
  expansion -> lock_in -> gemeinsame_entwicklung
}
nicht_dominanz -> Dominanz [label="⊖"]
pluralitaet -> homogenisierung [label="⊖"]

Kooperationsabsicht -> {Delegation Kontrolle fuersorge Normierung}
Normierung -> homogenisierung
tragfaehige_beziehung -> Kooperation -> expansion

Kooperationsabsicht -> Kooperation [color=grey style=dotted]

}
